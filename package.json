{
  "name": "gate-da-mastery",
  "version": "0.1.0",
  "private": true,
  "description": "GATE Data Science & Artificial Intelligence (DA) preparation platform: official PYQs with verified solutions, 50 progressive mock tests, analytics, revision and more.",
  "scripts": {
    "dev": "npm run content:build && next dev",
    "build": "npm run content:build && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:build": "tsx scripts/content/build.ts",
    "content:validate": "tsx scripts/content/build.ts --validate-only",
    "content:audit": "tsx scripts/content/audit.ts",
    "sources:verify": "tsx scripts/sources/verify.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run content:audit"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "katex": "^0.18.9",
    "lucide-react": "^1.48.0",
    "minisearch": "^7.2.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.2"
  }
}
